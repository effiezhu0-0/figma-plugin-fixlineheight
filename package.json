{
  "name": "line-height-fixer",
  "version": "1.0.0",
  "description": "Line Height Fixer Figma plugin",
  "main": "dist/code.js",
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build && tsc -p tsconfig.code.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --fix",
    "watch": "vite build --watch"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@figma/eslint-plugin-figma-plugins": "*",
    "@figma/plugin-typings": "*",
    "@types/react": "^18.3.8",
    "@types/react-dom": "^18.3.0",
    "eslint": "^9.39.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.1",
    "vite": "^5.4.10",
    "vite-plugin-singlefile": "^2.0.3"
  }
}